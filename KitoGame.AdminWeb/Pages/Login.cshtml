@page
@model KitoGame.AdminWeb.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Acceso Backoffice Maestro";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KitoGame Backoffice - Control Maestro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            color: #F8FAFC;
        }
        .login-card {
            background: #1E293B;
            border: 1px solid #334155;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
            max-width: 440px;
            width: 100%;
            padding: 36px 32px;
        }
        .logo-badge {
            background: #F59E0B;
            color: #0F172A;
            width: 68px;
            height: 68px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            margin: 0 auto 16px auto;
            box-shadow: 0 8px 20px rgba(245, 158, 11, 0.3);
        }
        .form-control {
            background-color: #0F172A;
            border: 1.5px solid #334155;
            color: #F8FAFC;
            border-radius: 10px;
            padding: 12px 14px;
        }
        .form-control:focus {
            background-color: #0F172A;
            border-color: #F59E0B;
            color: #F8FAFC;
            box-shadow: 0 0 0 0.25rem rgba(245, 158, 11, 0.2);
        }
        .btn-gold {
            background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
            color: #0F172A;
            font-weight: 700;
            border: none;
            border-radius: 10px;
            padding: 12px;
            transition: all 0.2s ease-in-out;
        }
        .btn-gold:hover {
            background: linear-gradient(135deg, #D97706 0%, #B45309 100%);
            color: #FFFFFF;
            transform: translateY(-1px);
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center">
            <div class="logo-badge">
                <i class="fa-solid fa-crown"></i>
            </div>
            <h3 class="fw-bold text-white mb-1">KitoGame Backoffice</h3>
            <p class="text-secondary small mb-4">Panel Maestro de Control y Administración</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2 small rounded-3" role="alert">
                <i class="fa-solid fa-circle-exclamation me-1"></i> @Model.ErrorMessage
            </div>
        }

        <form method="post">
            <div class="mb-3">
                <label class="form-label small fw-semibold text-light">Usuario o Correo de Administrador</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fa-solid fa-user"></i></span>
                    <input type="text" asp-for="Username" class="form-control" placeholder="Ej: ivan o ivan.pautt@gmail.com" required autofocus />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label small fw-semibold text-light">Contraseña Maestra</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fa-solid fa-lock"></i></span>
                    <input type="password" asp-for="Password" class="form-control" placeholder="••••••••" required />
                </div>
            </div>

            <button type="submit" class="btn btn-gold w-100 mb-3">
                <i class="fa-solid fa-right-to-bracket me-2"></i> Iniciar Sesión de Control
            </button>
        </form>

        <div class="text-center text-muted small mt-3">
            <i class="fa-solid fa-shield-halved text-warning me-1"></i> Acceso restringido al operador maestro
        </div>
    </div>
</body>
</html>
