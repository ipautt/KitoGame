<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KitoGame.Pages.GameMatchPage"
             Title="Partida en Vivo"
             BackgroundColor="#FAF5E8">

    <ScrollView>
        <VerticalStackLayout Padding="12,12,12,28" Spacing="10" MaximumWidthRequest="520" HorizontalOptions="Fill">

            <!-- Cabecera del Pozo y Apuesta en Custodia -->
            <Border BackgroundColor="#FFFBEB"
                    Stroke="#F59E0B"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,10">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label x:Name="LblMatchTitle"
                               Grid.Column="0"
                               Text="Partida en Vivo • #KITO"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1E293B"
                               VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                BackgroundColor="#10B981"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="8,3">
                            <Label x:Name="LblPotBadge"
                                   Text="POZO: $2.000 COP"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                        <Label x:Name="LblPrizeBreakdown"
                               Grid.Column="0"
                               Text="Premio Neto: $1.800 COP (Comisión 10%)"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#B45309"
                               VerticalOptions="Center" />

                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label x:Name="LblConnectionStatus"
                                   Text="🟢 En Vivo"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#16A34A"
                                   VerticalOptions="Center" />
                            <Button x:Name="BtnManualSync"
                                    Text="🔄 Refrescar"
                                    Clicked="OnManualSyncClicked"
                                    BackgroundColor="#2563EB"
                                    TextColor="#FFFFFF"
                                    FontAttributes="Bold"
                                    FontSize="10"
                                    HeightRequest="28"
                                    Padding="8,0"
                                    CornerRadius="6" />
                            <Button x:Name="BtnMatchSettings"
                                    Text="⚙ Ajustes"
                                    Clicked="OnMatchSettingsClicked"
                                    BackgroundColor="#FEF3C7"
                                    TextColor="#92400E"
                                    BorderColor="#F59E0B"
                                    BorderWidth="1.2"
                                    FontAttributes="Bold"
                                    FontSize="10"
                                    HeightRequest="28"
                                    Padding="6,0"
                                    CornerRadius="6" />
                        </HorizontalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ========================================================================= -->
            <!-- TARJETA DEL CONTRINCANTE (Arriba del tablero, del lado de sus fichas)     -->
            <!-- ========================================================================= -->
            <Border x:Name="OpponentCardBorder"
                    BackgroundColor="#FFFFFF"
                    Stroke="#8B5CF6"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <!-- Avatar del Contrincante -->
                    <Border Grid.Column="0"
                            BackgroundColor="#F3E8FF"
                            Stroke="#7C3AED"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 22"
                            WidthRequest="44"
                            HeightRequest="44"
                            VerticalOptions="Center">
                        <Label Text="🎯" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <!-- Nombre y Estado del Contrincante -->
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="6">
                            <Label x:Name="LblOpponentName"
                                   Text="CONTRINCANTE: @Carlos_M"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B" />
                        </HorizontalStackLayout>
                        <Label x:Name="LblOpponentStatus"
                               Text="🟢 En línea • Esperando tu jugada"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#6D28D9" />
                    </VerticalStackLayout>

                    <!-- Fichas Activas y Color de Corona del Contrincante -->
                    <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="End" VerticalOptions="Center">
                        <Border BackgroundColor="#F3E8FF"
                                Stroke="#C084FC"
                                StrokeShape="RoundRectangle 8"
                                Padding="8,2"
                                HorizontalOptions="End">
                            <Label x:Name="LblPlayer2Count"
                                   Text="12 fichas"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#5B21B6" />
                        </Border>
                        <Label Text="Reina: 🟣♛ Morada"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#7C3AED"
                               HorizontalOptions="End" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Indicador de Turno y Ayuda -->
            <Border x:Name="TurnBannerBorder"
                    BackgroundColor="#ECFDF5"
                    Stroke="#10B981"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 12"
                    Padding="10,8">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="LblTurnBanner"
                           Text="Tu turno (Fichas Rojas)"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#065F46"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="LblHelperHint"
                           Text="Toca una de tus fichas de abajo para ver las casillas verdes disponibles."
                           FontSize="11"
                           TextColor="#047857"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- ========================================================================= -->
            <!-- BARRA DE CONTROL DE PARCHÍS (Dado 3D Interactivo y Reglas)                -->
            <!-- ========================================================================= -->
            <Border x:Name="ParchisControlBar"
                    IsVisible="False"
                    BackgroundColor="#1E293B"
                    Stroke="#F59E0B"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <!-- Dos Dados 3D de Parqués con Puntos Grandes -->
                    <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                        <Border x:Name="ParchisDiceBox1"
                                WidthRequest="44"
                                HeightRequest="44"
                                BackgroundColor="#FFFFFF"
                                Stroke="#D97706"
                                StrokeThickness="2.5"
                                StrokeShape="RoundRectangle 10"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            <Label x:Name="LblDice1Glyph"
                                   Text="⚀"
                                   FontSize="28"
                                   TextColor="#DC2626"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Border x:Name="ParchisDiceBox2"
                                WidthRequest="44"
                                HeightRequest="44"
                                BackgroundColor="#FFFFFF"
                                Stroke="#D97706"
                                StrokeThickness="2.5"
                                StrokeShape="RoundRectangle 10"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            <Label x:Name="LblDice2Glyph"
                                   Text="⚀"
                                   FontSize="28"
                                   TextColor="#DC2626"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Mensaje de los Dados y Bonificaciones -->
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label x:Name="LblParchisDiceStatus"
                               Text="DADOS: 1 + 1 = 2 🎲"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#F59E0B" />
                        <Label x:Name="LblParchisDiceSub"
                               Text="Toca '🎲 Tirar' para lanzar los 2 dados"
                               FontSize="11"
                               TextColor="#E2E8F0" />
                    </VerticalStackLayout>

                    <!-- Botón de Lanzar Dados -->
                    <Button Grid.Column="2"
                            x:Name="BtnRollDice"
                            Text="🎲 Tirar"
                            Clicked="OnBtnRollDiceClicked"
                            BackgroundColor="#F59E0B"
                            TextColor="#1E293B"
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="10"
                            Padding="12,4"
                            HeightRequest="42"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Tablero Gráfico 2D/3D de Alta Precisión -->
            <Border BackgroundColor="#FFFBEB"
                    Stroke="#D97706"
                    StrokeThickness="2.5"
                    StrokeShape="RoundRectangle 16"
                    Padding="3"
                    HorizontalOptions="Center">
                <GraphicsView x:Name="BoardCanvasView"
                              WidthRequest="356"
                              HeightRequest="356"
                              StartInteraction="OnBoardCanvasTouch" />
            </Border>

            <!-- ========================================================================= -->
            <!-- TARJETA DEL JUGADOR LOCAL (Abajo del tablero, del lado de tus fichas)     -->
            <!-- ========================================================================= -->
            <Border x:Name="Player1CardBorder"
                    BackgroundColor="#FFFFFF"
                    Stroke="#EF4444"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <!-- Avatar del Jugador Local -->
                    <Border Grid.Column="0"
                            BackgroundColor="#FEF2F2"
                            Stroke="#EF4444"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 22"
                            WidthRequest="44"
                            HeightRequest="44"
                            VerticalOptions="Center">
                        <Label Text="👑" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <!-- Nombre y Estado del Jugador -->
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label x:Name="LblPlayer1Name"
                               Text="TÚ: IVAN PAUTT"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#1E293B" />
                        <Label x:Name="LblPlayer1Status"
                               Text="🔴 Tus fichas están en la parte inferior"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#B91C1C" />
                    </VerticalStackLayout>

                    <!-- Fichas Activas y Color de Corona del Jugador -->
                    <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="End" VerticalOptions="Center">
                        <Border BackgroundColor="#FEF2F2"
                                Stroke="#FCA5A5"
                                StrokeShape="RoundRectangle 8"
                                Padding="8,2"
                                HorizontalOptions="End">
                            <Label x:Name="LblPlayer1Count"
                                   Text="12 fichas"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#991B1B" />
                        </Border>
                        <Label Text="Reina: 🔴★ Roja/Oro"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#B45309"
                               HorizontalOptions="End" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Controles de Partida -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="🤝 Declarar Tablas (Empate)"
                        Clicked="OnDrawClicked"
                        BackgroundColor="#FFFFFF"
                        TextColor="#334155"
                        BorderColor="#CBD5E1"
                        BorderWidth="1.5"
                        FontSize="12"
                        FontAttributes="Bold"
                        HeightRequest="42"
                        CornerRadius="10" />

                <Button Grid.Column="1"
                        Text="🏳️ Rendirse"
                        Clicked="OnResignClicked"
                        BackgroundColor="#FEE2E2"
                        TextColor="#B91C1C"
                        BorderColor="#FCA5A5"
                        BorderWidth="1.5"
                        FontSize="12"
                        FontAttributes="Bold"
                        HeightRequest="42"
                        CornerRadius="10" />
            </Grid>

            <!-- Botón de Prueba Rápida de Victoria (Solo visible para el Administrador) -->
            <Button x:Name="BtnAdminSimulateWin"
                    Text="🏆 Simular Victoria Inmediata (Solo Admin)"
                    Clicked="OnSimulateWinP1Clicked"
                    BackgroundColor="#ECFDF5"
                    TextColor="#047857"
                    BorderColor="#10B981"
                    BorderWidth="1.5"
                    FontSize="12"
                    FontAttributes="Bold"
                    HeightRequest="38"
                    CornerRadius="10"
                    IsVisible="False" />

            <!-- Registro de Movimientos -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    Padding="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="📋 Historial de Jugadas:"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#475569" />
                    <Label x:Name="LblMoveLog"
                           Text="Partida iniciada. Tú juegas con las fichas de abajo."
                           FontSize="12"
                           TextColor="#334155" />
                </VerticalStackLayout>
            </Border>

            <!-- ========================================================================= -->
            <!-- CHAT EN VIVO DE LA SALA (Saber cuándo entra el rival y comunicarse)       -->
            <!-- ========================================================================= -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="#CBD5E1"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,10">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Label Text="💬 Chat en Vivo de la Sala"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B"
                                   VerticalOptions="Center" />
                            <Label x:Name="LblChatCountBadge"
                                   Text="0 mensajes"
                                   FontSize="10"
                                   TextColor="#64748B"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Button x:Name="BtnToggleChat"
                                Grid.Column="1"
                                Text="Ocultar"
                                Clicked="OnToggleChatClicked"
                                BackgroundColor="Transparent"
                                TextColor="#2563EB"
                                FontSize="11"
                                FontAttributes="Bold"
                                HeightRequest="28"
                                Padding="6,0" />
                    </Grid>

                    <VerticalStackLayout x:Name="ChatBodyLayout" Spacing="8">
                        <Border BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 10"
                                Padding="8"
                                HeightRequest="130">
                            <ScrollView x:Name="ChatScrollView">
                                <VerticalStackLayout x:Name="ChatMessagesStack" Spacing="6">
                                    <Label Text="Sala iniciada. Esperando mensajes..."
                                           FontSize="11"
                                           TextColor="#94A3B8"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </ScrollView>
                        </Border>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="6">
                                <Button Text="👋 ¡Hola!"
                                        Clicked="OnQuickMessageClicked"
                                        BackgroundColor="#EFF6FF"
                                        TextColor="#1D4ED8"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        HeightRequest="28"
                                        Padding="8,0"
                                        CornerRadius="6" />
                                <Button Text="👍 ¡Buena jugada!"
                                        Clicked="OnQuickMessageClicked"
                                        BackgroundColor="#ECFDF5"
                                        TextColor="#047857"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        HeightRequest="28"
                                        Padding="8,0"
                                        CornerRadius="6" />
                                <Button Text="⏳ Ya voy"
                                        Clicked="OnQuickMessageClicked"
                                        BackgroundColor="#FFFBEB"
                                        TextColor="#B45309"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        HeightRequest="28"
                                        Padding="8,0"
                                        CornerRadius="6" />
                                <Button Text="🔥 ¡Buena partida!"
                                        Clicked="OnQuickMessageClicked"
                                        BackgroundColor="#FEF2F2"
                                        TextColor="#B91C1C"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        HeightRequest="28"
                                        Padding="8,0"
                                        CornerRadius="6" />
                            </HorizontalStackLayout>
                        </ScrollView>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry x:Name="TxtChatMessage"
                                   Grid.Column="0"
                                   Placeholder="Escribe al contrincante..."
                                   FontSize="12"
                                   BackgroundColor="#F1F5F9"
                                   TextColor="#1E293B"
                                   HeightRequest="38"
                                   Completed="OnSendChatMessageClicked" />
                            <Button x:Name="BtnSendChat"
                                    Grid.Column="1"
                                    Text="Enviar"
                                    Clicked="OnSendChatMessageClicked"
                                    BackgroundColor="#2563EB"
                                    TextColor="#FFFFFF"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    HeightRequest="38"
                                    Padding="14,0"
                                    CornerRadius="8" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

