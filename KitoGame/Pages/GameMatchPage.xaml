<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KitoGame.Pages.GameMatchPage"
             Title="Partida en Vivo"
             BackgroundColor="#FAF5E8">

    <ScrollView>
        <VerticalStackLayout Padding="12,12,12,28" Spacing="10" MaximumWidthRequest="520" HorizontalOptions="Fill">

            <!-- Cabecera del Pozo y Apuesta en Custodia -->
            <Border BackgroundColor="#FFFBEB"
                    Stroke="#F59E0B"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,10">
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="LblMatchTitle"
                               Grid.Column="0"
                               Text="🔴 Damas Clásicas • #DAMAS1K"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#1E293B" />
                        <Border Grid.Column="1"
                                BackgroundColor="#10B981"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="8,3">
                            <Label x:Name="LblPotBadge"
                                   Text="POZO: $2.000 COP"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </Border>
                    </Grid>

                    <Label x:Name="LblPrizeBreakdown"
                           Text="Premio Neto al Ganador: $1.800 COP (Comisión 10%: $200 COP)"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#B45309" />
                </VerticalStackLayout>
            </Border>

            <!-- ========================================================================= -->
            <!-- TARJETA DEL CONTRINCANTE (Arriba del tablero, del lado de sus fichas)     -->
            <!-- ========================================================================= -->
            <Border x:Name="OpponentCardBorder"
                    BackgroundColor="#FFFFFF"
                    Stroke="#8B5CF6"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <!-- Avatar del Contrincante -->
                    <Border Grid.Column="0"
                            BackgroundColor="#F3E8FF"
                            Stroke="#7C3AED"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 22"
                            WidthRequest="44"
                            HeightRequest="44"
                            VerticalOptions="Center">
                        <Label Text="🎯" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <!-- Nombre y Estado del Contrincante -->
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="6">
                            <Label x:Name="LblOpponentName"
                                   Text="CONTRINCANTE: @Carlos_M"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B" />
                        </HorizontalStackLayout>
                        <Label x:Name="LblOpponentStatus"
                               Text="🟢 En línea • Esperando tu jugada"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#6D28D9" />
                    </VerticalStackLayout>

                    <!-- Fichas Activas y Color de Corona del Contrincante -->
                    <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="End" VerticalOptions="Center">
                        <Border BackgroundColor="#F3E8FF"
                                Stroke="#C084FC"
                                StrokeShape="RoundRectangle 8"
                                Padding="8,2"
                                HorizontalOptions="End">
                            <Label x:Name="LblPlayer2Count"
                                   Text="12 fichas"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#5B21B6" />
                        </Border>
                        <Label Text="Reina: 🟣♛ Morada"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#7C3AED"
                               HorizontalOptions="End" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Indicador de Turno y Ayuda -->
            <Border x:Name="TurnBannerBorder"
                    BackgroundColor="#ECFDF5"
                    Stroke="#10B981"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 12"
                    Padding="10,8">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="LblTurnBanner"
                           Text="Tu turno (Fichas Rojas)"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#065F46"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="LblHelperHint"
                           Text="Toca una de tus fichas de abajo para ver las casillas verdes disponibles."
                           FontSize="11"
                           TextColor="#047857"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Tablero Gráfico 2D/3D de Alta Precisión -->
            <Border BackgroundColor="#FFFBEB"
                    Stroke="#D97706"
                    StrokeThickness="2.5"
                    StrokeShape="RoundRectangle 16"
                    Padding="3"
                    HorizontalOptions="Center">
                <GraphicsView x:Name="BoardCanvasView"
                              WidthRequest="356"
                              HeightRequest="356"
                              StartInteraction="OnBoardCanvasTouch" />
            </Border>

            <!-- ========================================================================= -->
            <!-- TARJETA DEL JUGADOR LOCAL (Abajo del tablero, del lado de tus fichas)     -->
            <!-- ========================================================================= -->
            <Border x:Name="Player1CardBorder"
                    BackgroundColor="#FFFFFF"
                    Stroke="#EF4444"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <!-- Avatar del Jugador Local -->
                    <Border Grid.Column="0"
                            BackgroundColor="#FEF2F2"
                            Stroke="#EF4444"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 22"
                            WidthRequest="44"
                            HeightRequest="44"
                            VerticalOptions="Center">
                        <Label Text="👑" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <!-- Nombre y Estado del Jugador -->
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label x:Name="LblPlayer1Name"
                               Text="TÚ: IVAN PAUTT"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#1E293B" />
                        <Label x:Name="LblPlayer1Status"
                               Text="🔴 Tus fichas están en la parte inferior"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#B91C1C" />
                    </VerticalStackLayout>

                    <!-- Fichas Activas y Color de Corona del Jugador -->
                    <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="End" VerticalOptions="Center">
                        <Border BackgroundColor="#FEF2F2"
                                Stroke="#FCA5A5"
                                StrokeShape="RoundRectangle 8"
                                Padding="8,2"
                                HorizontalOptions="End">
                            <Label x:Name="LblPlayer1Count"
                                   Text="12 fichas"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#991B1B" />
                        </Border>
                        <Label Text="Reina: 🔴★ Roja/Oro"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#B45309"
                               HorizontalOptions="End" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Controles de Partida -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="🤝 Declarar Tablas (Empate)"
                        Clicked="OnDrawClicked"
                        BackgroundColor="#FFFFFF"
                        TextColor="#334155"
                        BorderColor="#CBD5E1"
                        BorderWidth="1.5"
                        FontSize="12"
                        FontAttributes="Bold"
                        HeightRequest="42"
                        CornerRadius="10" />

                <Button Grid.Column="1"
                        Text="🏳️ Rendirse"
                        Clicked="OnResignClicked"
                        BackgroundColor="#FEE2E2"
                        TextColor="#B91C1C"
                        BorderColor="#FCA5A5"
                        BorderWidth="1.5"
                        FontSize="12"
                        FontAttributes="Bold"
                        HeightRequest="42"
                        CornerRadius="10" />
            </Grid>

            <!-- Botón de Prueba Rápida de Victoria (Solo visible para el Administrador) -->
            <Button x:Name="BtnAdminSimulateWin"
                    Text="🏆 Simular Victoria Inmediata (Solo Admin)"
                    Clicked="OnSimulateWinP1Clicked"
                    BackgroundColor="#ECFDF5"
                    TextColor="#047857"
                    BorderColor="#10B981"
                    BorderWidth="1.5"
                    FontSize="12"
                    FontAttributes="Bold"
                    HeightRequest="38"
                    CornerRadius="10"
                    IsVisible="False" />

            <!-- Registro de Movimientos -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    Padding="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="📋 Historial de Jugadas:"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#475569" />
                    <Label x:Name="LblMoveLog"
                           Text="Partida iniciada. Tú juegas con las fichas de abajo."
                           FontSize="12"
                           TextColor="#334155" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

