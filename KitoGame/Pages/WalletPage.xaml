<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KitoGame.Pages.WalletPage"
             Title="Mi Billetera y Pagos"
             BackgroundColor="#FAF5E8">

    <ScrollView>
        <VerticalStackLayout Padding="16,18,16,36" Spacing="12" MaximumWidthRequest="520" HorizontalOptions="Fill">

            <!-- Tarjeta Resumen de Fondos -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="#F59E0B"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="LblUserHeader"
                           Text="Billetera de Ivan Pautt"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" BackgroundColor="#ECFDF5" Stroke="#10B981" StrokeShape="RoundRectangle 12" Padding="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="SALDO DISPONIBLE" FontSize="10" FontAttributes="Bold" TextColor="#065F46" />
                                <Label x:Name="LblAvailableBalance"
                                       Text="$5.000 COP"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#047857" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="#FFFBEB" Stroke="#F59E0B" StrokeShape="RoundRectangle 12" Padding="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="EN CUSTODIA (RETOS)" FontSize="10" FontAttributes="Bold" TextColor="#92400E" />
                                <Label x:Name="LblLockedBalance"
                                       Text="$0 COP"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#D97706" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Toca la opción que desees abrir:"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#78350F"
                   Margin="4,2,0,0" />

            <!-- ========================================================================= -->
            <!-- RECUADRO PLEGABLE 1: SOLICITAR RECARGA (Recogido por defecto)             -->
            <!-- ========================================================================= -->
            <Border BackgroundColor="#FFFFFF" Stroke="#3B82F6" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" Padding="14">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleW1Tapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               Text="💳 1. SOLICITAR RECARGA DE SALDO"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1D4ED8"
                               VerticalOptions="Center" />
                        <Button x:Name="BtnToggleW1"
                                Grid.Column="1"
                                Text="▼ Abrir"
                                Clicked="OnToggleW1Tapped"
                                BackgroundColor="#EFF6FF"
                                TextColor="#1D4ED8"
                                BorderColor="#93C5FD"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                FontSize="11"
                                HeightRequest="30"
                                Padding="10,0"
                                CornerRadius="8" />
                    </Grid>

                    <VerticalStackLayout x:Name="W1Content" Spacing="12" IsVisible="False">
                        <Label Text="El saldo solo se agregará a tu cuenta una vez que el pago sea confirmado:"
                               FontSize="12"
                               TextColor="#475569" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Medio de Pago" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                            <Border BackgroundColor="#FFFDF7" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" Padding="6,0">
                                <Picker x:Name="PickerPaymentMethod"
                                        Title="Selecciona medio de pago"
                                        TextColor="#1E293B"
                                        BackgroundColor="Transparent">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Nequi</x:String>
                                            <x:String>PSE / Transferencia Bancaria</x:String>
                                            <x:String>Daviplata</x:String>
                                            <x:String>Tarjeta Débito / Crédito</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="$2.000" Clicked="OnPreset2000Clicked" BackgroundColor="#ECFDF5" TextColor="#047857" BorderColor="#10B981" BorderWidth="1.5" FontAttributes="Bold" CornerRadius="8" />
                            <Button Grid.Column="1" Text="$5.000" Clicked="OnPreset5000Clicked" BackgroundColor="#ECFDF5" TextColor="#047857" BorderColor="#10B981" BorderWidth="1.5" FontAttributes="Bold" CornerRadius="8" />
                            <Button Grid.Column="2" Text="$20.000" Clicked="OnPreset20000Clicked" BackgroundColor="#ECFDF5" TextColor="#047857" BorderColor="#10B981" BorderWidth="1.5" FontAttributes="Bold" CornerRadius="8" />
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Monto a Recargar (COP)" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                            <Border BackgroundColor="#FFFDF7" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" Padding="6,0">
                                <Entry x:Name="EntryDepositAmount" Text="5000" Keyboard="Numeric" TextColor="#1E293B" FontAttributes="Bold" BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="🧾 Generar Orden de Pago"
                                Clicked="OnCreatePaymentOrderClicked"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                FontAttributes="Bold"
                                HeightRequest="42"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ========================================================================= -->
            <!-- RECUADRO PLEGABLE 2: CONFIRMAR PAGOS PENDIENTES (Recogido por defecto)    -->
            <!-- ========================================================================= -->
            <Border BackgroundColor="#FFFFFF" Stroke="#F59E0B" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" Padding="14">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleW2Tapped" />
                        </Grid.GestureRecognizers>
                        <Label x:Name="LblW2Title"
                               Grid.Column="0"
                               Text="⏳ 2. VERIFICACIÓN Y CONFIRMACIÓN DE PAGOS"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#B45309"
                               VerticalOptions="Center" />
                        <Button x:Name="BtnToggleW2"
                                Grid.Column="1"
                                Text="▼ Abrir"
                                Clicked="OnToggleW2Tapped"
                                BackgroundColor="#FFFBEB"
                                TextColor="#B45309"
                                BorderColor="#FCD34D"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                FontSize="11"
                                HeightRequest="30"
                                Padding="10,0"
                                CornerRadius="8" />
                    </Grid>

                    <VerticalStackLayout x:Name="W2Content" Spacing="10" IsVisible="False">
                        <Label Text="Confirma aquí las órdenes de pago realizadas para abonar el saldo a tu billetera:"
                               FontSize="12"
                               TextColor="#475569" />
                        <VerticalStackLayout x:Name="PaymentRequestsContainer" Spacing="10" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ========================================================================= -->
            <!-- RECUADRO PLEGABLE 3: INSCRIBIR CUENTA PARA RETIROS (Recogido por defecto) -->
            <!-- ========================================================================= -->
            <Border BackgroundColor="#FFFFFF" Stroke="#8B5CF6" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" Padding="14">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleW3Tapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               Text="🏦 3. INSCRIBIR CUENTA DESTINO PARA RETIROS"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#6D28D9"
                               VerticalOptions="Center" />
                        <Button x:Name="BtnToggleW3"
                                Grid.Column="1"
                                Text="▼ Abrir"
                                Clicked="OnToggleW3Tapped"
                                BackgroundColor="#F3E8FF"
                                TextColor="#6D28D9"
                                BorderColor="#C084FC"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                FontSize="11"
                                HeightRequest="30"
                                Padding="10,0"
                                CornerRadius="8" />
                    </Grid>

                    <VerticalStackLayout x:Name="W3Content" Spacing="12" IsVisible="False">
                        <Border BackgroundColor="#FFFBEB" Stroke="#F59E0B" StrokeShape="RoundRectangle 10" Padding="10">
                            <Label x:Name="LblCurrentPayoutAccount"
                                   Text="⚠️ Sin cuenta inscrita para retiros"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#B45309" />
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Banco o Billetera *" FontSize="11" FontAttributes="Bold" TextColor="#334155" />
                                <Border BackgroundColor="#FFFDF7" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" Padding="4,0">
                                    <Picker x:Name="PickerPayoutBank" Title="Elige entidad" TextColor="#1E293B" BackgroundColor="Transparent">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>Nequi</x:String>
                                                <x:String>Daviplata</x:String>
                                                <x:String>Bancolombia</x:String>
                                                <x:String>Davivienda</x:String>
                                                <x:String>Nu Colombia</x:String>
                                                <x:String>Banco de Bogotá</x:String>
                                                <x:String>BBVA</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Tipo de Cuenta *" FontSize="11" FontAttributes="Bold" TextColor="#334155" />
                                <Border BackgroundColor="#FFFDF7" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" Padding="4,0">
                                    <Picker x:Name="PickerPayoutType" Title="Tipo" TextColor="#1E293B" BackgroundColor="Transparent">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>Billetera Móvil (Celular)</x:String>
                                                <x:String>Cuenta de Ahorros</x:String>
                                                <x:String>Cuenta Corriente</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Número de Cuenta o Celular *" FontSize="11" FontAttributes="Bold" TextColor="#334155" />
                                <Border BackgroundColor="#FFFDF7" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" Padding="6,0">
                                    <Entry x:Name="EntryPayoutAccountNumber" Placeholder="Ej: 3001234567" Keyboard="Numeric" PlaceholderColor="#94A3B8" TextColor="#1E293B" BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Cédula / Documento Titular *" FontSize="11" FontAttributes="Bold" TextColor="#334155" />
                                <Border BackgroundColor="#FFFDF7" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" Padding="6,0">
                                    <Entry x:Name="EntryPayoutDocumentId" Placeholder="Ej: 1020304050" Keyboard="Numeric" PlaceholderColor="#94A3B8" TextColor="#1E293B" BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Button Text="💾 Guardar Cuenta de Retiro"
                                Clicked="OnSavePayoutAccountClicked"
                                BackgroundColor="#7C3AED"
                                TextColor="White"
                                FontAttributes="Bold"
                                HeightRequest="42"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ========================================================================= -->
            <!-- RECUADRO PLEGABLE 4: RETIRAR GANANCIAS (Recogido por defecto)             -->
            <!-- ========================================================================= -->
            <Border BackgroundColor="#FFFFFF" Stroke="#EF4444" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" Padding="14">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleW4Tapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               Text="💸 4. RETIRAR GANANCIAS A MI CUENTA"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#B91C1C"
                               VerticalOptions="Center" />
                        <Button x:Name="BtnToggleW4"
                                Grid.Column="1"
                                Text="▼ Abrir"
                                Clicked="OnToggleW4Tapped"
                                BackgroundColor="#FEF2F2"
                                TextColor="#B91C1C"
                                BorderColor="#FCA5A5"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                FontSize="11"
                                HeightRequest="30"
                                Padding="10,0"
                                CornerRadius="8" />
                    </Grid>

                    <VerticalStackLayout x:Name="W4Content" Spacing="10" IsVisible="False">
                        <Label x:Name="LblWithdrawDestinationHint"
                               Text="El dinero será transferido a tu cuenta inscrita."
                               FontSize="12"
                               TextColor="#334155" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0" BackgroundColor="#FFFDF7" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" Padding="6,0">
                                <Entry x:Name="EntryWithdrawAmount"
                                       Placeholder="Monto a retirar (ej: 2000)"
                                       Keyboard="Numeric"
                                       PlaceholderColor="#94A3B8"
                                       TextColor="#1E293B"
                                       BackgroundColor="Transparent" />
                            </Border>
                            <Button Grid.Column="1"
                                    Text="Retirar Fondos"
                                    Clicked="OnWithdrawClicked"
                                    BackgroundColor="#DC2626"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="10" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ========================================================================= -->
            <!-- RECUADRO PLEGABLE 5: HISTORIAL DE MOVIMIENTOS (Recogido por defecto)      -->
            <!-- ========================================================================= -->
            <Border BackgroundColor="#FFFFFF" Stroke="#CBD5E1" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" Padding="14">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleW5Tapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               Text="📊 5. HISTORIAL DE MOVIMIENTOS"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#334155"
                               VerticalOptions="Center" />
                        <Button x:Name="BtnToggleW5"
                                Grid.Column="1"
                                Text="▼ Abrir"
                                Clicked="OnToggleW5Tapped"
                                BackgroundColor="#F8FAFC"
                                TextColor="#334155"
                                BorderColor="#CBD5E1"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                FontSize="11"
                                HeightRequest="30"
                                Padding="10,0"
                                CornerRadius="8" />
                    </Grid>

                    <VerticalStackLayout x:Name="W5Content" Spacing="8" IsVisible="False">
                        <VerticalStackLayout x:Name="TransactionsContainer" Spacing="8" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

