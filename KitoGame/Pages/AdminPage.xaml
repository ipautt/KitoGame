<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KitoGame.Pages.AdminPage"
             Title="Panel de Administración"
             BackgroundColor="#FAF5E8">

    <ScrollView>
        <VerticalStackLayout Padding="16,20,16,32" Spacing="16" MaximumWidthRequest="540" HorizontalOptions="Fill">

            <!-- Recaudo de la Plataforma -->
            <Border BackgroundColor="#FFFBEB"
                    Stroke="#F59E0B"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 16"
                    Padding="18">
                <VerticalStackLayout Spacing="6">
                    <Label Text="🏦 TESORERÍA DE LA PLATAFORMA (COMISIONES RECAUDADAS)"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#B45309" />
                    <Label x:Name="LblPlatformRevenue"
                           Text="$0 COP"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />
                    <Label Text="Acumulado histórico cobrado automáticamente al liquidar partidas."
                           FontSize="12"
                           TextColor="#475569" />
                </VerticalStackLayout>
            </Border>

            <!-- Ajuste de Porcentaje de Comisión del Sistema -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="#10B981"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 16"
                    Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="⚙️ AJUSTAR PORCENTAJE DE COMISIÓN DE LA CASA"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#047857" />

                    <Label x:Name="LblCurrentPercentage"
                           Text="Comisión actual: 10%"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />

                    <Slider x:Name="SliderCommission"
                            Minimum="0"
                            Maximum="30"
                            Value="0"
                            ValueChanged="OnSliderCommissionChanged"
                            MinimumTrackColor="#10B981"
                            MaximumTrackColor="#CBD5E1"
                            ThumbColor="#059669" />

                    <!-- Botones predefinidos -->
                    <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                        <Button Grid.Column="0" Text="0%" Clicked="OnSet0Clicked" BackgroundColor="#ECFDF5" TextColor="#047857" BorderColor="#10B981" BorderWidth="1.5" FontAttributes="Bold" CornerRadius="8" />
                        <Button Grid.Column="1" Text="5%" Clicked="OnSet5Clicked" BackgroundColor="#FFFBEB" TextColor="#B45309" BorderColor="#F59E0B" BorderWidth="1" FontAttributes="Bold" CornerRadius="8" />
                        <Button Grid.Column="2" Text="10%" Clicked="OnSet10Clicked" BackgroundColor="#FFFBEB" TextColor="#B45309" BorderColor="#F59E0B" BorderWidth="1" FontAttributes="Bold" CornerRadius="8" />
                        <Button Grid.Column="3" Text="15%" Clicked="OnSet15Clicked" BackgroundColor="#FFFBEB" TextColor="#B45309" BorderColor="#F59E0B" BorderWidth="1" FontAttributes="Bold" CornerRadius="8" />
                        <Button Grid.Column="4" Text="20%" Clicked="OnSet20Clicked" BackgroundColor="#FFFBEB" TextColor="#B45309" BorderColor="#F59E0B" BorderWidth="1" FontAttributes="Bold" CornerRadius="8" />
                    </Grid>

                    <!-- Ejemplo en Vivo con Apuesta de $1.000 COP -->
                    <Border BackgroundColor="#FFFBEB"
                            Stroke="#FCD34D"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="SIMULACIÓN EN TIEMPO REAL (Ejemplo: Reto de $1.000 vs $1.000):"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#92400E" />
                            <Label x:Name="LblSimulationExample"
                                   Text="• Pozo Total: $2.000 COP&#10;• Comisión Plataforma (10%): $200 COP&#10;• Premio al Ganador: $1.800 COP"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B" />
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="💾 Guardar Porcentaje de Comisión"
                            Clicked="OnSaveCommissionClicked"
                            BackgroundColor="#10B981"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="46"
                            CornerRadius="12" />
                </VerticalStackLayout>
            </Border>

            <!-- Usuarios Registrados y Saldos -->
            <VerticalStackLayout Spacing="8">
                <Label Text="👥 USUARIOS REGISTRADOS EN EL SISTEMA"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#1E293B" />
                <VerticalStackLayout x:Name="UsersListContainer" Spacing="8" />
            </VerticalStackLayout>

            <!-- Botón Reiniciar Datos de Prueba -->
            <Button Text="🔄 Reiniciar Datos de Prueba de Fábrica"
                    Clicked="OnResetDemoDataClicked"
                    BackgroundColor="#FEE2E2"
                    TextColor="#B91C1C"
                    BorderColor="#FCA5A5"
                    BorderWidth="1"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="44" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

